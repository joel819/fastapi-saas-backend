# Copy to .env and edit. Every variable is optional; defaults are shown.

APP_NAME=fastapi-saas-backend
ENVIRONMENT=development      # development | production (production refuses the default JWT_SECRET)
DATABASE_URL=sqlite:///./data/app.db
SEED_ON_STARTUP=true         # create the sample users on startup

# Auth
JWT_SECRET=dev-insecure-change-me   # CHANGE THIS before running in production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe (leave STRIPE_SECRET_KEY empty for demo mode with the mock provider).
# Use test-mode keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
PUBLIC_BASE_URL=http://localhost:8000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_BILLING=10/minute
